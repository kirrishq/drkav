# Server-side site origin used for absolute canonical URLs.
SITE_URL=http://localhost:3000

# Backward-compatible fallback; SITE_URL takes precedence in server code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only connection used by ContentRepository. Never use NEXT_PUBLIC_ for the token.
STRAPI_API_URL=
STRAPI_API_TOKEN=

# Production CMS cache TTL. Invalid values fail with a configuration error.
CMS_REVALIDATE_SECONDS=3600
