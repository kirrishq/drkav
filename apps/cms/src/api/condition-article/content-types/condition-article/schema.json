{
  "kind": "collectionType",
  "collectionName": "condition_articles",
  "info": { "singularName": "condition-article", "pluralName": "condition-articles", "displayName": "Condition Article" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true, "unique": true },
    "excerpt": { "type": "text", "required": true },
    "cover": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "isFeatured": { "type": "boolean", "required": true, "default": false },
    "seo": { "type": "component", "component": "shared.seo", "repeatable": false, "required": true },
    "contentSections": { "type": "dynamiczone", "components": ["blog.rich-text-section", "blog.callout", "blog.faq"] },
    "relatedOperations": { "type": "relation", "relation": "manyToMany", "target": "api::operation.operation" }
  }
}
