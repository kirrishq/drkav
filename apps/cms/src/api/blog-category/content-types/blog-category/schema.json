{
  "kind": "collectionType",
  "collectionName": "blog_categories",
  "info": {
    "singularName": "blog-category",
    "pluralName": "blog-categories",
    "displayName": "Категория блога"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "key": { "type": "uid", "targetField": "name", "required": true, "unique": true },
    "order": { "type": "integer", "required": true, "default": 0 },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-article.blog-article",
      "mappedBy": "categories"
    }
  }
}
