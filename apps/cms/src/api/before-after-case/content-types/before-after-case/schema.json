{
  "kind": "collectionType",
  "collectionName": "before_after_cases",
  "info": {
    "singularName": "before-after-case",
    "pluralName": "before-after-cases",
    "displayName": "Результат до и после"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true, "unique": true },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "date": { "type": "date", "required": false },
    "isFeatured": { "type": "boolean", "required": true, "default": false },
    "operation": { "type": "relation", "relation": "manyToOne", "target": "api::operation.operation" }
  }
}
