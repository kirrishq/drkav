{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Отзыв пациента"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "text": { "type": "text", "required": true },
    "kind": { "type": "enumeration", "enum": ["patient", "prodoctorov", "social", "video"], "required": true, "default": "patient" },
    "image": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "video": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["videos"] },
    "externalUrl": { "type": "string" },
    "date": { "type": "date", "required": false },
    "operation": { "type": "relation", "relation": "manyToOne", "target": "api::operation.operation" }
  }
}
