{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Patient Review"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true, "unique": true },
    "text": { "type": "text", "required": true },
    "source": { "type": "string", "required": true },
    "kind": { "type": "enumeration", "enum": ["patient", "prodoctorov", "social", "video"], "required": true, "default": "patient" },
    "imageUrl": { "type": "string", "required": true },
    "imageAlt": { "type": "string" },
    "externalUrl": { "type": "string" },
    "sortOrder": { "type": "integer", "required": true, "min": 0 },
    "operation": { "type": "relation", "relation": "manyToOne", "target": "api::operation.operation" }
  }
}
