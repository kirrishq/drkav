{
  "kind": "collectionType",
  "collectionName": "price_items",
  "info": {
    "singularName": "price-item",
    "pluralName": "price-items",
    "displayName": "Price Item",
    "description": "Reusable structured price shared by operations and future price surfaces"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "publicName": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "priceType": {
      "type": "enumeration",
      "enum": ["fixed", "from", "range", "on-request", "included"],
      "required": true
    },
    "amount": {
      "type": "integer",
      "required": false,
      "min": 1
    },
    "minAmount": {
      "type": "integer",
      "required": false,
      "min": 1
    },
    "maxAmount": {
      "type": "integer",
      "required": false,
      "min": 1
    },
    "currency": {
      "type": "enumeration",
      "enum": ["RUB"],
      "required": true,
      "default": "RUB"
    },
    "unitLabel": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text",
      "required": false
    },
    "note": {
      "type": "text",
      "required": false
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "validFrom": {
      "type": "date",
      "required": false
    },
    "validUntil": {
      "type": "date",
      "required": false
    },
    "operations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::operation.operation",
      "mappedBy": "prices"
    }
  },
  "config": {}
}
