{
  "kind": "collectionType",
  "collectionName": "static_pages",
  "info": {
    "singularName": "static-page",
    "pluralName": "static-pages",
    "displayName": "Static Page",
    "description": "Content for a fixed frontend route bound by a stable pageKey"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true
    },
    "pageKey": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "canonicalPath": {
      "type": "string",
      "required": false,
      "unique": true,
      "regex": "^\\/[a-z0-9-]+(?:\\/[a-z0-9-]+)*$"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "heading": {
      "type": "string",
      "required": false
    },
    "heroDescription": {
      "type": "text",
      "required": false
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "primaryAction": {
      "type": "component",
      "component": "shared.action",
      "repeatable": false,
      "required": false
    },
    "secondaryAction": {
      "type": "component",
      "component": "shared.action",
      "repeatable": false,
      "required": false
    },
    "contentSections": {
      "type": "dynamiczone",
      "components": [
        "static-page.rich-text-section",
        "static-page.checklist-section",
        "static-page.tests-section",
        "static-page.card-grid-section",
        "static-page.faq-section"
      ]
    },
    "sharedSections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::shared-section.shared-section",
      "inversedBy": "staticPages"
    },
    "contentStatus": {
      "type": "enumeration",
      "enum": ["empty", "partial", "ready"],
      "required": true,
      "default": "empty"
    }
  },
  "config": {}
}
