{
  "kind": "collectionType",
  "collectionName": "promotions",
  "info": {
    "singularName": "promotion",
    "pluralName": "promotions",
    "displayName": "Акция",
    "description": "Public promotion cards"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string",
      "required": false
    },
    "cardDescription": {
      "type": "text",
      "required": false
    },
    "href": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "date": {
      "type": "date",
      "required": false
    },
    "validUntil": {
      "type": "date",
      "required": false
    },
    "content": {
      "type": "blocks",
      "required": false
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    }
  }
}
