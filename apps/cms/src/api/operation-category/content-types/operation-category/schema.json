{
  "kind": "collectionType",
  "collectionName": "operation_categories",
  "info": {
    "singularName": "operation-category",
    "pluralName": "operation-categories",
    "displayName": "Категория операций",
    "description": "Editorial and user-facing groups for operations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "hasLandingPage": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "landingPageKey": {
      "type": "string",
      "required": false
    },
    "showInCatalog": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "catalogOrder": {
      "type": "integer",
      "required": false
    },
    "catalogImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featuredOperation": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::operation.operation"
    },
    "operations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::operation.operation",
      "mappedBy": "categories"
    }
  },
  "config": {}
}
