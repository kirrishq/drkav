{
  "kind": "collectionType",
  "collectionName": "media_publications",
  "info": {
    "singularName": "media-publication",
    "pluralName": "media-publications",
    "displayName": "Media Publication"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true, "unique": true },
    "canonicalPath": { "type": "string", "required": false, "unique": true },
    "excerpt": { "type": "text", "required": true },
    "sourceName": { "type": "string", "required": true },
    "sourceDateLabel": { "type": "string", "required": false },
    "sourceUrl": { "type": "string", "required": true },
    "externalUrl": { "type": "string", "required": false },
    "isExternal": { "type": "boolean", "required": true, "default": false },
    "layoutVariant": { "type": "enumeration", "enum": ["primary", "featured"], "required": true, "default": "featured" },
    "imagePath": { "type": "string", "required": false },
    "imageAlt": { "type": "string", "required": false },
    "sortOrder": { "type": "integer", "required": true, "min": 0 },
    "readingTimeMinutes": { "type": "integer", "required": false, "min": 1 },
    "seo": { "type": "component", "component": "shared.seo", "repeatable": false, "required": false },
    "contentSections": { "type": "dynamiczone", "components": ["blog.rich-text-section"] }
  }
}
