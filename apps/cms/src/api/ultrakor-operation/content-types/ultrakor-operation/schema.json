{
  "kind": "collectionType",
  "collectionName": "ultrakor_operations",
  "info": {
    "singularName": "ultrakor-operation",
    "pluralName": "ultrakor-operations",
    "displayName": "Операция Ультракора",
    "description": "SEO-контент и редакционные материалы для зон программы Ультракор"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "slug": {
      "type": "uid",
      "targetField": "internalName",
      "required": true,
      "unique": true
    },
    "zoneSlug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 80
    },
    "canonicalPath": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "heading": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "breadcrumbLabel": {
      "type": "string",
      "required": false,
      "maxLength": 80
    },
    "heroDescription": {
      "type": "text",
      "required": true
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "contentSections": {
      "type": "dynamiczone",
      "components": [
        "operation.rich-text-section",
        "operation.list-section",
        "operation.steps-section",
        "operation.checklist-section",
        "operation.price-section",
        "operation.video"
      ]
    },
    "priceName": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "priceType": {
      "type": "enumeration",
      "enum": ["fixed", "from", "range", "on-request"],
      "required": true,
      "default": "from"
    },
    "priceLabel": {
      "type": "string",
      "required": false,
      "maxLength": 80
    },
    "priceAmount": {
      "type": "integer",
      "required": false,
      "min": 1
    },
    "priceMinAmount": {
      "type": "integer",
      "required": false,
      "min": 1
    },
    "priceMaxAmount": {
      "type": "integer",
      "required": false,
      "min": 1
    },
    "priceCurrency": {
      "type": "enumeration",
      "enum": ["RUB"],
      "required": true,
      "default": "RUB"
    },
    "priceUnitLabel": {
      "type": "string",
      "required": false,
      "maxLength": 80
    },
    "priceDescription": {
      "type": "text",
      "required": false
    },
    "priceNote": {
      "type": "text",
      "required": false
    }
  },
  "config": {}
}
