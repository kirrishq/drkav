{
  "kind": "collectionType",
  "collectionName": "video_cases",
  "info": { "singularName": "video-case", "pluralName": "video-cases", "displayName": "Видеокейс" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "location": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true, "unique": true },
    "year": { "type": "string", "required": false },
    "poster": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images"] },
    "mp4": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["videos"] },
    "webm": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["videos"] },
    "sortOrder": { "type": "integer", "required": true, "min": 0 }
  }
}
