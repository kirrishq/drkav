{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "description": "Search and sharing metadata independent from a frontend framework"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "required": true,
      "minLength": 10,
      "maxLength": 80
    },
    "metaDescription": {
      "type": "text",
      "required": true,
      "minLength": 50,
      "maxLength": 200
    },
    "shareImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "canonicalPath": {
      "type": "string",
      "required": false
    },
    "noIndex": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  },
  "config": {}
}
