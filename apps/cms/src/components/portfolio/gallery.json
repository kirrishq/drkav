{
  "collectionName": "components_portfolio_galleries",
  "info": { "displayName": "Portfolio Gallery" },
  "attributes": {
    "sectionKey": { "type": "string", "required": true },
    "heading": { "type": "string", "required": false },
    "caption": { "type": "text", "required": false },
    "images": {
      "type": "media",
      "multiple": true,
