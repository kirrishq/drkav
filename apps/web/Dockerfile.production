FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile

ARG SITE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG WEB_BUILD_STRAPI_API_URL
ARG CMS_REVALIDATE_SECONDS=3600
ARG NEXT_PUBLIC_YANDEX_METRIKA_ID
ARG NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY

ENV SITE_URL=$SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV STRAPI_API_URL=$WEB_BUILD_STRAPI_API_URL
ENV CMS_REVALIDATE_SECONDS=$CMS_REVALIDATE_SECONDS
ENV NEXT_PUBLIC_YANDEX_METRIKA_ID=$NEXT_PUBLIC_YANDEX_METRIKA_ID
ENV NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=$NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY

# The read-only token is mounted only for the build and is not persisted in the image.
RUN --mount=type=secret,id=strapi_api_token,required=true \
    export STRAPI_API_TOKEN="$(cat /run/secrets/strapi_api_token)" && \
    pnpm --filter @drkav/web build

ENV NODE_ENV=production

EXPOSE 3000

CMD ["pnpm", "--filter", "@drkav/web", "start"]
