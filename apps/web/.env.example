# Server-side site origin used to build absolute canonical URLs.
SITE_URL=http://localhost:3000

# Backward-compatible fallback; SITE_URL takes precedence in server code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Strapi connection. Copy to .env.local and provide a read-only token.
STRAPI_API_URL=
STRAPI_API_TOKEN=

# Production CMS cache TTL; minimum 60 seconds, default 3600.
CMS_REVALIDATE_SECONDS=3600

# Server-side CMS request timeout in milliseconds; default 30000.
CMS_REQUEST_TIMEOUT_MS=30000

# Public analytics counter from the original drkav.ru site.
NEXT_PUBLIC_YANDEX_METRIKA_ID=87650551

# Form delivery: mailpit for local development, amo for the production proxy, disabled to block submissions.
FORM_DELIVERY_MODE=disabled
MAILPIT_URL=http://127.0.0.1:8025
MAILPIT_FROM=drkav-local@example.invalid
MAILPIT_TO=qa@example.invalid

# Server-side amoCRM proxy. Keep the code and proxy URL server-only.
AMO_ENABLED=false
AMO_PROXY_URL=https://drkav.ru/amo/amo.php
AMO_CODE=
AMO_PIPELINE_ID=5284933
AMO_STATUS_ID=47117170
AMO_REQUEST_TIMEOUT_MS=8000
