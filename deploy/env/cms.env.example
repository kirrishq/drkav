NODE_ENV=production
HOST=0.0.0.0
PORT=1337

DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@PRIVATE_DB_HOST:5432/DB_NAME
DATABASE_SSL=true
DATABASE_SSL_CA_PATH=/run/secrets/beget_database_ca
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

APP_KEYS=GENERATE_KEY_1,GENERATE_KEY_2,GENERATE_KEY_3,GENERATE_KEY_4
API_TOKEN_SALT=GENERATE_SECRET
ADMIN_JWT_SECRET=GENERATE_SECRET
TRANSFER_TOKEN_SALT=GENERATE_SECRET
JWT_SECRET=GENERATE_SECRET
ENCRYPTION_KEY=GENERATE_SECRET

# Set this after the staging hostname has HTTPS.
PUBLIC_URL=https://cms-staging.drkav.ru
