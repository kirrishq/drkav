NODE_ENV=production
SITE_URL=https://staging.drkav.ru
NEXT_PUBLIC_SITE_URL=https://staging.drkav.ru

# Runtime connection stays inside the Docker network.
STRAPI_API_URL=http://cms:1337
# Public base URL for media migrated from Strapi local uploads.
MEDIA_PUBLIC_URL=https://s3.ru1.storage.beget.cloud/BUCKET_NAME
STRAPI_API_TOKEN=READ_ONLY_STRAPI_TOKEN
CMS_REVALIDATE_SECONDS=3600
CMS_REQUEST_TIMEOUT_MS=30000

FORM_DELIVERY_MODE=disabled
TRUST_PROXY_HEADERS=true
REQUIRE_FORM_ORIGIN=true

# Early in-process protection for page and API requests. Keep the proxy in front
# of the app: this reduces application work but does not replace L7 WAF/CDN.
WEB_RATE_LIMIT_ENABLED=true
WEB_RATE_LIMIT_WINDOW_MS=60000
WEB_RATE_LIMIT_PAGE_MAX=180
WEB_RATE_LIMIT_API_MAX=30

NEXT_PUBLIC_YANDEX_METRIKA_ID=87650551
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_ENABLED=false
SMARTCAPTCHA_SERVER_KEY=

AMO_ENABLED=false
AMO_PROXY_URL=
AMO_CODE=
AMO_PIPELINE_ID=
AMO_STATUS_ID=
AMO_REQUEST_TIMEOUT_MS=8000
