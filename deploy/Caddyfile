{$SITE_DOMAIN} {
    log {
        output stdout
        format json
    }

    @known_scanners path /.env /.env/* /.git /.git/* /cgi-bin /cgi-bin/* /phpmyadmin /phpmyadmin/* /server-status /vendor/phpunit /vendor/phpunit/* /wp-admin /wp-admin/* /wp-login.php /xmlrpc.php
    respond @known_scanners 404

    # Keep the public media bucket on the site origin so client networks do
    # not need to connect to Beget S3 directly. Restrict the proxy to the
    # project's bucket instead of exposing an open S3 proxy.
    @media path /media/39799ed5839c-drkav-media/*
    handle @media {
        uri strip_prefix /media
        reverse_proxy https://s3.ru1.storage.beget.cloud {
            header_up Host s3.ru1.storage.beget.cloud
        }
    }

    handle {
        encode zstd gzip
        reverse_proxy web:3000
    }
}

www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}

# Redirect the HTTP www variant directly to the canonical HTTPS host instead
# of letting Caddy emit an intermediate HTTP -> HTTPS redirect first.
http://www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$CMS_DOMAIN} {
    log {
        output stdout
        format json
    }

    encode zstd gzip

    @cms_admin_entry {
        path /admin /admin/
    }

    basic_auth @cms_admin_entry {
        {$CMS_BASIC_AUTH_USER} {$CMS_BASIC_AUTH_HASH}
    }

    # Strapi protects its admin and plugin routes with its own session/JWT.
    # Keep the public content API and direct upload storage closed from the
    # internet while allowing the admin application to call its own routes.
    @cms_public path /api /api/* /uploads /uploads/*
    handle @cms_public {
        respond 404
    }

    reverse_proxy cms:1337
}
