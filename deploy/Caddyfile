{$SITE_DOMAIN} {
    log {
        output stdout
        format json
    }

    @known_scanners path /.env /.env/* /.git /.git/* /cgi-bin /cgi-bin/* /phpmyadmin /phpmyadmin/* /server-status /vendor/phpunit /vendor/phpunit/* /wp-admin /wp-admin/* /wp-login.php /xmlrpc.php
    respond @known_scanners 404

    encode zstd gzip
    reverse_proxy web:3000
}

{$CMS_DOMAIN} {
    log {
        output stdout
        format json
    }

    encode zstd gzip

    @cms_admin_entry {
        path /admin /admin/
    }

    basic_auth @cms_admin_entry {
        {$CMS_BASIC_AUTH_USER} {$CMS_BASIC_AUTH_HASH}
    }

    # Strapi protects the admin API with its own session/JWT. Caddy only
    # protects the initial admin document; public CMS API and upload paths
    # stay closed from the internet.
    @cms_admin path /admin /admin/*
    handle @cms_admin {
        reverse_proxy cms:1337
    }

    handle {
        respond 404
    }
}
