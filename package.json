{
  "name": "drkav",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @drkav/web dev",
    "check:styles": "node scripts/check-no-css-modules.mjs",
    "lint": "pnpm check:styles && eslint apps packages --max-warnings=0",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json --noEmit && tsc -p packages/content-contracts/tsconfig.json --noEmit",
    "build": "pnpm --filter @drkav/web build"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "typescript": "^5.9.2"
  }
}
